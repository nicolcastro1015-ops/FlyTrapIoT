<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".DetalleActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETALLE TRAMPA"
            android:textAlignment="center"
            android:textColor="@color/rosa_oscuro"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="# 1"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/txt_codigo_sector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Codigo sector : SEC-01"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txt_tipo_trampa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo trampa : McPhail"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txt_nivel_captura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivel captura : 0"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txt_observaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observaciones : Sin observaciones"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <Button
            android:id="@+id/boton_editar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/boton_principal"
            android:textColor="@color/white"
            android:text="Editar Trampa" />

        <Button
            android:id="@+id/boton_eliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/boton_eliminar"
            android:textColor="@color/white"
            android:text="Eliminar Trampa" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
