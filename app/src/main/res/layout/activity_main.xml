<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FlyTrap IoT"
            android:textAlignment="center"
            android:textColor="@color/rosa_oscuro"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Codigo del sector *"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_codigo_sector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:hint="Ej: SEC-01"
            android:inputType="text" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de trampa *"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_tipo_trampa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:hint="Ej: McPhail, Jackson"
            android:inputType="text" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivel de captura *"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_nivel_captura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:hint="Cantidad de moscas capturadas"
            android:inputType="number" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observaciones (opcional)"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_observaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:inputType="text" />

        <Button
            android:id="@+id/boton_registrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/boton_principal"
            android:textColor="@color/white"
            android:text="Registrar Trampa" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Trampas Registradas"
            android:textAlignment="center"
            android:textColor="@color/rosa_oscuro"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- weight 1: la lista ocupa el espacio restante de la pantalla -->
        <ListView
            android:id="@+id/lista_trampas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/borde_lista"
            android:divider="@color/rosa_claro"
            android:dividerHeight="1dp"
            android:padding="4dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
