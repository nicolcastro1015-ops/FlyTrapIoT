<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".EditarActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar Trampa"
            android:textAlignment="center"
            android:textColor="@color/rosa_oscuro"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Codigo del sector *"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_codigo_sector2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:inputType="text" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de trampa *"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_tipo_trampa2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:inputType="text" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivel de captura *"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_nivel_captura2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:inputType="number" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observaciones (opcional)"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/input_observaciones2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/borde_campo"
            android:ems="10"
            android:padding="10dp"
            android:inputType="text" />

        <Button
            android:id="@+id/boton_guardar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/boton_principal"
            android:textColor="@color/white"
            android:text="Guardar Cambios" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
